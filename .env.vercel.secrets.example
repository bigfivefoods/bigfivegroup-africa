# Copy to .env.vercel.secrets (gitignored), fill values, then:
#   export VERCEL_TOKEN=vercel_xxxx
#   npm run env:vercel
#
# Or use: npm run setup:newsletter (interactive helper)

# --- Analytics (optional) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=bigfivegroup.africa
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SAM_VIDEO_URL=

# --- Site URL (email links) ---
NEXT_PUBLIC_SITE_URL=https://bigfivegroup.africa

# --- Newsletter / Resend (required for production double opt-in) ---
# From Resend dashboard → API Keys
RESEND_API_KEY=re_xxxxxxxx

# Must use a domain verified in Resend (Domains → add bigfivegroup.africa)
# Examples:
#   Big Five Group <news@bigfivegroup.africa>
#   Big Five Group <hello@bigfivegroup.africa>
#   Big Five Group <onboarding@resend.dev>   # Resend test domain only (limited)
NEWSLETTER_FROM_EMAIL=Big Five Group <news@bigfivegroup.africa>

# Generated secrets (openssl rand -base64 32) — do not reuse across projects
NEWSLETTER_SECRET=
NEWSLETTER_ADMIN_SECRET=

# Durable store on Vercel (strongly recommended)
# Create free Redis at https://console.upstash.com → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional CRM fan-out
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=
