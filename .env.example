# Optional: send contact form emails via Resend (https://resend.com)
# Without these, enquiries open a mailto: draft for the user.
RESEND_API_KEY=
# Verified sender, e.g. "Big Five Group <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives enquiries (defaults to craig@bigfivegroup.africa)
CONTACT_TO_EMAIL=

# Optional: Zapier / Make / Formspree webhook — POST JSON on each enquiry
CONTACT_WEBHOOK_URL=

# Optional: public Calendly (or other) booking link on /contact
NEXT_PUBLIC_CALENDLY_URL=

# Optional analytics (privacy-aware — only loads when set)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: YouTube/Vimeo embed URL for SAM walkthrough on /connect/sam
NEXT_PUBLIC_SAM_VIDEO_URL=
