# =============================================================================
# Big Five Group Africa — environment variables
# Copy to .env.local for local Next.js development:
#   cp .env.example .env.local
#
# Contact form: opens the visitor’s own mail app to craig@bigfivegroup.africa
# (no Resend / third-party mail required).
#
# For Vercel: set optional keys below in Project → Settings → Environment Variables
# or run:  npm run env:vercel   (requires VERCEL_TOKEN)
# =============================================================================

# --- Booking (optional) ------------------------------------------------------
# Public Calendly (or similar) link shown on /contact
# e.g. https://calendly.com/your-team/briefing
NEXT_PUBLIC_CALENDLY_URL=

# --- Analytics (optional; scripts only load when set) ------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- SAM walkthrough video (optional embed on /connect/sam) ------------------
# YouTube embed URL, e.g. https://www.youtube.com/embed/VIDEO_ID
NEXT_PUBLIC_SAM_VIDEO_URL=
