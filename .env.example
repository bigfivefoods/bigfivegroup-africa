# =============================================================================
# Big Five Group Africa — environment variables
# Copy to .env.local for local Next.js development:
#   cp .env.example .env.local
#
# Contact: visitors email craig@bigfivegroup.africa from their own mail app
# (same as footer). No third-party mail or calendar booking tools required.
# =============================================================================

# --- Analytics (optional; scripts only load when set) ------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- SAM walkthrough video (optional embed on /connect/sam) ------------------
# YouTube embed URL, e.g. https://www.youtube.com/embed/VIDEO_ID
NEXT_PUBLIC_SAM_VIDEO_URL=

# --- Investor portal (private /investor) -------------------------------------
# Long random secret used to sign session cookies (min 16 characters).
# Generate e.g.: openssl rand -base64 32
# Set this in Vercel → Project → Settings → Environment Variables (Production).
# A code fallback exists if unset, but production should set this explicitly.
INVESTOR_SESSION_SECRET=

# Optional extra allowlist (comma-separated). Code list is also used:
#   app/lib/investor-allowlist.ts  (craig@… and clint@… already listed)
# Example: INVESTOR_EMAILS=partner@fund.com,lp@familyoffice.com
INVESTOR_EMAILS=
