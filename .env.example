# =============================================================================
# Big Five Group Africa — environment variables
# Copy to .env.local for local Next.js development:
#   cp .env.example .env.local
#
# Contact: visitors email craig@bigfivegroup.africa from their own mail app
# (same as footer). No third-party mail or calendar booking tools required.
# =============================================================================

# --- Analytics (optional; scripts only load when set) ------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- SAM walkthrough video (optional embed on /connect/sam) ------------------
# YouTube embed URL, e.g. https://www.youtube.com/embed/VIDEO_ID
NEXT_PUBLIC_SAM_VIDEO_URL=

# --- Investor portal (private /investor) -------------------------------------
# Long random secret used to sign session cookies (min 16 characters).
# Generate e.g.: openssl rand -base64 32
# Set this in Vercel → Project → Settings → Environment Variables (Production).
# A code fallback exists if unset, but production should set this explicitly.
INVESTOR_SESSION_SECRET=

# Optional extra allowlist (comma-separated). Code list is also used:
#   app/lib/investor-allowlist.ts  (craig@… and clint@… already listed)
# Example: INVESTOR_EMAILS=partner@fund.com,lp@familyoffice.com
INVESTOR_EMAILS=

# --- Partner portal (private /partner) ---------------------------------------
# Optional separate signing secret (min 16 chars). Falls back to investor secret
# with a partner prefix, then a built-in fallback.
PARTNER_SESSION_SECRET=

# Optional extra partner allowlist (comma-separated). Prefer defining partners in:
#   app/lib/partners.ts  (each org has slug + emails[] → /partner/[slug])
# Env-only emails land on /partner/general until mapped to a partner profile.
# Example: PARTNER_EMAILS=ops@ngo.org,procurement@ministry.gov.za
PARTNER_EMAILS=

# --- Newsletter (world-class subscribe / confirm / prefs / unsub) ------------
# Signing secret for confirm / unsubscribe / preference tokens (min 16 chars).
# Generate: openssl rand -base64 32
NEWSLETTER_SECRET=

# Durable store on Vercel (recommended): free Upstash Redis REST credentials
# https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional override path for local JSON store (default: data/newsletter-subscribers.json)
# NEWSLETTER_STORE_PATH=

# Contact form inbox (optional; defaults to craig@bigfivegroup.africa)
# CONTACT_INBOX_EMAIL=craig@bigfivegroup.africa

# Resend (https://resend.com) — contact form delivery, double opt-in, campaigns
RESEND_API_KEY=
# From address must be a verified domain in Resend, e.g.:
# NEWSLETTER_FROM_EMAIL=Big Five Group <news@bigfivegroup.africa>
NEWSLETTER_FROM_EMAIL=

# xAI / Grok — on-site newsletter composer (draft with Grok)
# https://console.x.ai → API keys
XAI_API_KEY=
# Optional model override (default grok-4.5)
# XAI_MODEL=grok-4.5


# Optional CRM / Make / Zapier fan-out on subscribe/confirm/unsub/preferences
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=

# Admin CSV/JSON export: GET /api/newsletter/admin (Bearer or ?secret=)
# Generate: openssl rand -base64 32  (min 16 chars)
NEWSLETTER_ADMIN_SECRET=

# Optional comma-separated extra blocked email domains
# NEWSLETTER_BLOCK_DOMAINS=example.invalid

# Public site URL used in email links (falls back to VERCEL_URL / bigfivegroup.africa)
# NEXT_PUBLIC_SITE_URL=https://bigfivegroup.africa

