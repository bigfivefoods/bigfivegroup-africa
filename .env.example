# =============================================================================
# Big Five Group Africa — environment variables
# Copy to .env.local for local Next.js development:
#   cp .env.example .env.local
#
# For Vercel production/preview, set the same keys in the project dashboard
# or run:  npm run env:vercel   (requires VERCEL_TOKEN)
# =============================================================================

# --- Contact form delivery (Resend) ------------------------------------------
# Without RESEND_API_KEY, /api/contact returns a mailto: draft for the user.
# 1. Create account at https://resend.com
# 2. Verify a domain (or use onboarding@resend.dev for testing only)
# 3. Create an API key and paste below
RESEND_API_KEY=
# Verified sender, e.g. "Big Five Group <hello@bigfivegroup.africa>"
CONTACT_FROM_EMAIL=Big Five Group <craig@bigfivegroup.africa>
# Inbox that receives enquiries
CONTACT_TO_EMAIL=craig@bigfivegroup.africa

# Optional: Zapier / Make / Formspree webhook URL (POST JSON on each enquiry)
CONTACT_WEBHOOK_URL=

# --- Booking -----------------------------------------------------------------
# Public Calendly (or similar) link shown on /contact
# e.g. https://calendly.com/your-team/briefing
NEXT_PUBLIC_CALENDLY_URL=

# --- Analytics (optional; scripts only load when set) ------------------------
# Plausible: use the domain you registered, e.g. bigfivegroup.africa
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- SAM walkthrough video (optional embed on /connect/sam) ------------------
# YouTube embed URL, e.g. https://www.youtube.com/embed/VIDEO_ID
NEXT_PUBLIC_SAM_VIDEO_URL=
