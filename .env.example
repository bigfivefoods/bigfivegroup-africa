# Optional: send contact form emails via Resend (https://resend.com)
RESEND_API_KEY=
# Verified sender, e.g. "Big Five Group <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives enquiries (defaults to craig@bigfivegroup.africa)
CONTACT_TO_EMAIL=

# Optional: Zapier / Make / Formspree webhook — POST JSON on each enquiry
CONTACT_WEBHOOK_URL=

# Optional: public Calendly (or other) booking link shown on /contact
NEXT_PUBLIC_CALENDLY_URL=
